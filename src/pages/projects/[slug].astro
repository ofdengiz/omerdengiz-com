---
/**
 * /projects/[slug] — one page per project in the content collection.
 *
 * Entries flagged `standalone` are excluded: they keep a dedicated route so
 * an existing public URL does not change. Today that is only /meta.
 */
import { getCollection } from 'astro:content';
import CaseStudy from '../../layouts/CaseStudy.astro';

export async function getStaticPaths() {
  const entries = await getCollection('projects', ({ data }) => !data.standalone);
  return entries.map((entry) => ({
    params: { slug: entry.id },
    props: { entry },
  }));
}

const { entry } = Astro.props;
---

<CaseStudy entry={entry} />
