---
/**
 * ThemeToggle: a three-way theme selector.
 *
 * Built as a radio group rather than a two-state button, for three reasons:
 *
 *  1. WCAG 2.5.3 (Label in Name). The previous version was a <button> with
 *     aria-label="Use dark theme" wrapping the visible text "LGT"/"DRK". The
 *     accessible name did not contain the visible text, so a voice-control
 *     user saying "click LGT" would hit nothing. Each radio now carries its
 *     own visible label as its accessible name.
 *  2. Semantics. These are mutually exclusive options, which is exactly what
 *     a radio group is. Arrow-key navigation comes free.
 *  3. A real gap: with a two-state toggle there was no way back to following
 *     the OS preference once an override had been set. SYS restores it.
 *
 * The palette resolves from the OS with zero JavaScript, because every token
 * is declared with light-dark() and the root sets `color-scheme: light dark`.
 * This control only writes an override.
 *
 * On flash-of-wrong-theme: the usual fix is a blocking inline script, which
 * `script-src 'self'` forbids. Rather than weaken the policy, only users who
 * chose a non-OS theme may see a brief correction on first paint. Everyone
 * else is served correctly by CSS alone, with no render-blocking script.
 */
const options = [
  { value: 'system', label: 'Sys', title: 'Follow system setting' },
  { value: 'light', label: 'Lgt', title: 'Light theme' },
  { value: 'dark', label: 'Drk', title: 'Dark theme' },
];
---

<fieldset class="theme" data-theme-control>
  <legend class="visually-hidden">Colour theme</legend>

  {
    options.map((o) => (
      <label class="theme__cell">
        <input
          type="radio"
          name="theme"
          value={o.value}
          class="theme__input"
          checked={o.value === 'system'}
        />
        <span class="theme__label">{o.label}</span>
        <span class="visually-hidden">{o.title}</span>
      </label>
    ))
  }
</fieldset>

<script>
  const KEY = 'theme';
  const root = document.documentElement;

  type Choice = 'system' | 'light' | 'dark';

  function paintMeta(choice: Choice) {
    const dark =
      choice === 'dark' ||
      (choice === 'system' && window.matchMedia('(prefers-color-scheme: dark)').matches);
    const meta = document.querySelector<HTMLMetaElement>('meta[name="theme-color"]:not([media])')
      ?? document.querySelector<HTMLMetaElement>('meta[name="theme-color"]');
    if (meta) {
      meta.removeAttribute('media');
      meta.content = dark ? '#0A0D12' : '#F5F4F0';
    }
  }

  function apply(choice: Choice, persist: boolean) {
    if (choice === 'system') {
      delete root.dataset.theme;
      if (persist) {
        try { localStorage.removeItem(KEY); } catch { /* storage may be blocked */ }
      }
    } else {
      root.dataset.theme = choice;
      if (persist) {
        try { localStorage.setItem(KEY, choice); } catch { /* storage may be blocked */ }
      }
    }

    for (const group of document.querySelectorAll('[data-theme-control]')) {
      const input = group.querySelector<HTMLInputElement>(`input[value="${choice}"]`);
      if (input) input.checked = true;
    }
    paintMeta(choice);
  }

  // Restore a previous override. Without one, CSS already has it right.
  let stored: string | null = null;
  try { stored = localStorage.getItem(KEY); } catch { /* ignore */ }
  const initial: Choice =
    stored === 'light' || stored === 'dark' ? stored : 'system';
  apply(initial, false);

  for (const group of document.querySelectorAll('[data-theme-control]')) {
    group.addEventListener('change', (e) => {
      const t = e.target as HTMLInputElement;
      if (t?.name === 'theme') apply(t.value as Choice, true);
    });
  }

  // Keep the browser chrome in step if the OS flips while on "system".
  window.matchMedia('(prefers-color-scheme: dark)').addEventListener('change', () => {
    if (!root.dataset.theme) paintMeta('system');
  });
</script>

<style>
  .theme {
    display: flex;
    margin: 0;
    padding: 0;
    border: var(--hairline) solid var(--rule-2);
    /* A fieldset ships with browser defaults that fight the drafting frame. */
    min-inline-size: 0;
  }

  .theme__cell {
    position: relative;
    display: grid;
    place-items: center;
    min-inline-size: 2.25rem;
    block-size: 2.25rem;
    cursor: pointer;
    transition: background var(--dur) var(--ease), color var(--dur) var(--ease);
  }

  .theme__cell + .theme__cell { border-inline-start: var(--hairline) solid var(--rule); }

  /* The input stays in the accessibility tree and keeps native keyboard
     behaviour; it is only removed from the visual layer. */
  .theme__input {
    position: absolute;
    inset: 0;
    opacity: 0;
    margin: 0;
    cursor: pointer;
  }

  .theme__label {
    font-family: var(--font-mono);
    font-size: var(--t-label);
    letter-spacing: 0.06em;
    text-transform: uppercase;
    color: var(--ink-3);
    pointer-events: none;
  }

  .theme__cell:hover .theme__label { color: var(--accent); }

  /* Selected cell is filled: the one filled element in the system, justified
     because it encodes current state. */
  .theme__cell:has(.theme__input:checked) { background: var(--ink); }
  .theme__cell:has(.theme__input:checked) .theme__label { color: var(--paper); }

  .theme__cell:has(.theme__input:focus-visible) {
    outline: 2px solid var(--accent);
    outline-offset: 2px;
  }
</style>
