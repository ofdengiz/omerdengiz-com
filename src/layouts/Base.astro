---
/**
 * Base.astro — the document shell every page inherits.
 *
 * Fonts are imported here rather than linked from Google. Fontsource ships the
 * woff2 files as npm packages, so Vite fingerprints and self-hosts them. That
 * removes a third-party origin from the critical path and lets Phase 6 delete
 * fonts.googleapis.com and fonts.gstatic.com from the CSP entirely.
 */
import '../styles/fonts.css';
import '../styles/tokens.css';
import '../styles/base.css';

/**
 * Preload the two faces that render above the fold: Space Grotesk carries the
 * page title (usually the LCP element) and Plex Sans carries body copy. Both
 * are discovered late otherwise — the browser has to parse CSS, resolve the
 * @font-face, and only then fetch — which is what shows up as layout shift
 * when the fallback is swapped out.
 *
 * Imported through Vite so the preload href carries the same content hash as
 * the stylesheet's url(), rather than being a second, unhashed copy.
 *
 * Mono is preloaded too, despite the usual advice to preload sparingly. In
 * this design mono is not decorative metadata — it sets every label and every
 * title-block value, all above the fold. Leaving it out measured as CLS 0.15
 * on the case-study pages: mono arrived after first paint and its fallback
 * (Courier New, stretched 116% to match) wrapped differently, changing the
 * title-block row heights and pushing the page down.
 */
import displayFont from '@fontsource-variable/space-grotesk/files/space-grotesk-latin-wght-normal.woff2?url';
import bodyFont from '@fontsource-variable/ibm-plex-sans/files/ibm-plex-sans-latin-wght-normal.woff2?url';
import monoFont from '@fontsource/ibm-plex-mono/files/ibm-plex-mono-latin-400-normal.woff2?url';

interface Props {
  title: string;
  description: string;
  /** Path-only canonical, e.g. "/projects/capstone". Defaults to the current URL. */
  canonical?: string;
  /** Keep this page out of search results. */
  noindex?: boolean;
}

const { title, description, canonical, noindex = false } = Astro.props;
const canonicalURL = new URL(canonical ?? Astro.url.pathname, Astro.site);
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta name="author" content="Omer Dengiz" />
    <link rel="canonical" href={canonicalURL} />
    {noindex && <meta name="robots" content="noindex, nofollow" />}

    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="omerdengiz.com" />
    <meta property="og:url" content={canonicalURL} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    {/* Absolute URL required — social crawlers do not resolve relative paths. */}
    <meta property="og:image" content={new URL('/assets/og.png', Astro.site)} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content="Omer Dengiz — Cloud, Systems, Networking" />

    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={new URL('/assets/og.png', Astro.site)} />

    {/* crossorigin is required on font preloads even same-origin, or the
        browser fetches the file twice. */}
    <link rel="preload" as="font" type="font/woff2" href={displayFont} crossorigin />
    <link rel="preload" as="font" type="font/woff2" href={bodyFont} crossorigin />
    <link rel="preload" as="font" type="font/woff2" href={monoFont} crossorigin />

    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />

    {/* Updated by ThemeToggle when an explicit override is active. */}
    <meta name="theme-color" content="#F5F4F0" media="(prefers-color-scheme: light)" />
    <meta name="theme-color" content="#0A0D12" media="(prefers-color-scheme: dark)" />
  </head>

  <body>
    <a class="skip-link" href="#main">Skip to content</a>
    <slot />
  </body>
</html>
