---
/**
 * Base.astro — the document shell every page inherits.
 *
 * Fonts are imported here rather than linked from Google. Fontsource ships the
 * woff2 files as npm packages, so Vite fingerprints and self-hosts them. That
 * removes a third-party origin from the critical path and lets Phase 6 delete
 * fonts.googleapis.com and fonts.gstatic.com from the CSP entirely.
 */
import '../styles/fonts.css';
import '../styles/tokens.css';
import '../styles/base.css';

interface Props {
  title: string;
  description: string;
  /** Path-only canonical, e.g. "/projects/capstone". Defaults to the current URL. */
  canonical?: string;
  /** Keep this page out of search results. */
  noindex?: boolean;
}

const { title, description, canonical, noindex = false } = Astro.props;
const canonicalURL = new URL(canonical ?? Astro.url.pathname, Astro.site);
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta name="author" content="Omer Dengiz" />
    <link rel="canonical" href={canonicalURL} />
    {noindex && <meta name="robots" content="noindex, nofollow" />}

    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="omerdengiz.com" />
    <meta property="og:url" content={canonicalURL} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />

    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />

    {/* Updated by ThemeToggle when an explicit override is active. */}
    <meta name="theme-color" content="#F5F4F0" media="(prefers-color-scheme: light)" />
    <meta name="theme-color" content="#0A0D12" media="(prefers-color-scheme: dark)" />
  </head>

  <body>
    <a class="skip-link" href="#main">Skip to content</a>
    <slot />
  </body>
</html>
